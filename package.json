{
  "name": "dsh-subagent-pro",
  "description": "DSH web extension: live subagent monitor + role-based subagent routing + Claude Code style .dsh/agents/*.md persona injection",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/<owner>/dsh-subagent-pro.git"
  },
  "homepage": "https://github.com/<owner>/dsh-subagent-pro#readme",
  "bugs": {
    "url": "https://github.com/<owner>/dsh-subagent-pro/issues"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/__tests__/*.test.ts",
    "verify:docs": "node scripts/verify-docs.mjs",
    "prepare": "npm run build"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "src",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs"
  ],
  "dependencies": {
    "gray-matter": "^4.0.3",
    "react": "^18.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-jobs": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-shell": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-subagent": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
